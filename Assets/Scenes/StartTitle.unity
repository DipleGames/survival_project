--- !u!114 &1598506496
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1598506494}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 3c320e93a676af547b4113880300873e, type: 3}
    m_FontSize: 40
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 3
    m_MaxSize: 50
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<\uAC8C\uC784 \uC124\uBA85>\n<color=lime>30\uC77C</color>\uB3D9\uC548
    \uB1E8\uD30C\uAC00 \uBC15\uC950\uC12C\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC544 \uD0C8\uCD9C\uD558\uB294
    \uAC8C\uC784\uC785\uB2C8\uB2E4.\n\n\uBC15\uC950\uB4E4\uC744 \uD1F4\uCE58\uD574
    \uC5BB\uC740 <color=lime>\uBC30\uD2B8\uCF54\uC778</color>\uC73C\uB85C <color=cyan>\uBB34\uAE30</color>\uC640
    <color=cyan>\uD328\uC2DC\uBE0C \uC544\uC774\uD15C</color>\uC744 \uAD6C\uB9E4\uD574
    \uB1E8\uD30C\uB97C \uC131\uC7A5\uC2DC\uD0A4\uACE0,\n\n\uBC15\uC950\uC12C\uC744
    \uD0C8\uCD9C\uD558\uB294 \uBC30\uB97C \uB9CC\uB4E4\uAE30 \uC704\uD574 \uAC8C\uC784
    \uB3C4\uC911 \uB098\uC624\uB294<color=lime> \uC774\uD30C\uB9AC \uB098\uBB34</color>\uB97C
    \uBC8C\uBAA9\uD574 \uB098\uBB34\uB97C <color=lime>70\uAC1C</color> \uC774\uC0C1
    \uC5BB\uC5B4\uC57C \uD569\uB2C8\uB2E4.\n\uB9CC\uC57D 30\uC77C\uC774 \uB05D\uB098\uAE30
    \uC804\uAE4C\uC9C0 \uB098\uBB34\uB97C \uB2E4 \uBAA8\uC73C\uC9C0 \uBABB\uD55C\uB2E4\uBA74
    \uD0C8\uCD9C\uC5D0 <color=red>\uC2E4\uD328</color>\uD569\uB2C8\uB2E4.\r\n\n<color=lime>10,20,30</color>
    \uB77C\uC6B4\uB4DC\uB294 <color=lime>\uBCF4\uC2A4\uB77C\uC6B4\uB4DC</color>\uC785\uB2C8\uB2E4.\n\uBCF4\uC2A4\uB77C\uC6B4\uB4DC\uB294
    \r\uC81C\uD55C \uC2DC\uAC04\uB3D9\uC548 <color=lime>\uBCF4\uC2A4 \uBAAC\uC2A4\uD130</color>\uC640
    <color=lime>\uC77C\uBC18 \uBAAC\uC2A4\uD130</color>\uB4E4\uC774 \uB3D9\uC2DC\uC5D0
    \uB4F1\uC7A5\uD569\uB2C8\uB2E4.\n\n\uC77C\uBC18 \uBAAC\uC2A4\uD130\uB294 <color=lime>\uC81C\uD55C
    \uC2DC\uAC04</color>\uB3D9\uC548 \uACC4\uC18D \uB4F1\uC7A5\uD558\uACE0 \uC2DC\uAC04\uC774
    \uB2E4 \uB05D\uB098\uBA74 \uC77C\uBC18 \uBAAC\uC2A4\uD130\uB294 \uB354 \uC774\uC0C1
    \uB4F1\uC7A5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \n\uC81C\uD55C \uC2DC\uAC04\uC774
    \uB05D\uB098\uAE30 \uC804\uC5D0 \uC7A1\uC740 \uC77C\uBC18 \uBAAC\uC2A4\uD130\uB294
    <color=lime>\uBC30\uD2B8 \uCF54\uC778</color>\uACFC <color=lime>\uACBD\uD5D8\uCE58</color>\uB97C
    \uBAA8\uB450 \uC8FC\uC9C0\uB9CC,\n\uC81C\uD55C \uC2DC\uAC04\uC774 \uB05D\uB09C
    \uD6C4\uC5D0 \uB0A8\uC544 \uC788\uB294 \uC77C\uBC18 \uBAAC\uC2A4\uD130\uB97C
    \uC7A1\uC73C\uBA74 <color=lime>\uACBD\uD5D8\uCE58</color>\uB9CC \uC90D\uB2C8\uB2E4.\n\n\uBCF4\uC2A4
    \uBAAC\uC2A4\uD130\uB294 <color=lime>10,20\uB77C\uC6B4\uB4DC</color>\uC5D0\uB294
    \uB2E4\uB978 \uC885\uB958 <color=lime>1\uB9C8\uB9AC</color>, \n<color=lime>30
    \uB77C\uC6B4\uB4DC</color>\uC5D0\uB294 10, 20\uB77C\uC6B4\uB4DC\uC5D0 \uB4F1\uC7A5\uD55C
    <color=lime>2\uB9C8\uB9AC</color> \uBCF4\uC2A4 \uBAAC\uC2A4\uD130\uAC00 \uB3D9\uC2DC\uC5D0
    \uB4F1\uC7A5\uD569\uB2C8\uB2E4.\n\uC81C\uD55C \uC2DC\uAC04\uC774 \uC9C0\uB098\uB3C4
    \uBCF4\uC2A4 \uBAAC\uC2A4\uD130\uB4E4\uC744 \uC804\uBD80 \uC7A1\uC9C0 \uBABB\uD558\uBA74
    \uD558\uB8E8\uAC00 <color=red>\uB05D\uB098\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4</color>.\r\n\n\uB098\uBB34\uB97C
    \uC5BB\uACE0 \uBC15\uC950\uB97C \uC4F0\uB7EC\uD2B8\uB9AC\uBA70 30\uC77C\uC744
    \uBC84\uD168\uC11C \uBC15\uC950\uC12C\uC744 \uD0C8\uCD9C\uD558\uC138\uC694!"

--- !u!114 &1593211269176214486
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1593211269176213544}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 3c320e93a676af547b4113880300873e, type: 3}
    m_FontSize: 40
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 3
    m_MaxSize: 50
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<\uAC8C\uC784 \uC815\uBCF4>\n\uCE90\uB9AD\uD130 \uBC29\uD5A5\uC870\uC791\uC740
    <color=lime>\uD0A4\uBCF4\uB4DC</color>, \uBB34\uAE30 \uC870\uC791\uC740 <color=lime>\uB9C8\uC6B0\uC2A4</color>\uB85C
    \uAC00\uB2A5\uD569\uB2C8\uB2E4. (<color=lime>\uC124\uC815</color>\uC5D0\uC11C
    \uD0A4 \uBCC0\uACBD, \uCEE4\uC11C \uBCC0\uACBD\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.)\n\n\uBAAC\uC2A4\uD130\uB97C
    \uC7A1\uC73C\uBA74 \uB098\uC624\uB294 \uBC30\uD2B8\uCF54\uC778\uC740 \uC77C\uC815
    \uBC94\uC704\uB0B4 <color=lime>\uB79C\uB364\uD55C</color> \uAE08\uC561\uC744
    \uAC00\uC9D1\uB2C8\uB2E4.\n\uB610 \uD558\uB8E8\uAC00 \uB05D\uB09C \uC0C1\uD0DC\uC5D0\uC11C
    \uBC14\uB2E5\uC5D0 \uB0A8\uC544\uC788\uB294 \uBC30\uD2B8 \uCF54\uC778\uB4E4\uC740
    <color=lime>1\uCF54\uC778</color>\uC73C\uB85C \uC804\uD658\uB3FC \uCE90\uB9AD\uD130\uC5D0\uAC8C
    \uB4E4\uC5B4\uC635\uB2C8\uB2E4.\n\n<color=lime>\uB300\uC26C \uC2A4\uD0AC</color>\uC740
    \uB300\uC26C \uD328\uC2DC\uBE0C \uC544\uC774\uD15C\uC744 \uD68D\uB4DD\uD574\uC57C
    \uC0AC\uC6A9\uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\n\uBB34\uAE30 \uC120\uD0DD\uCC3D
    \uC774\uD6C4, <color=lime>ESC</color>\uD0A4\uB97C \uB204\uB974\uBA74 <color=lime>\uC635\uC158\uCC3D</color>\uC774
    \uB098\uC635\uB2C8\uB2E4.\n\uC635\uC158\uCC3D\uC740 \uAC04\uB2E8\uD55C \uC18C\uB9AC
    \uC124\uC815, \uC77C\uC2DC\uC815\uC9C0 \uAE30\uB2A5, \uCEE4\uC11C \uC120\uD0DD
    \uAE30\uB2A5\uC744 \uD3EC\uD568\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n<color=lime>\uC774\uD30C\uB9AC
    \uB098\uBB34</color>\uB294 \uBC15\uC950\uC12C\uC758 \uB79C\uB364\uD55C \uC704\uCE58\uC5D0
    \uAE30\uBCF8 <color=lime>5\uAC1C</color> \uC0DD\uC131\uB418\uB294 \uC624\uBE0C\uC81D\uD2B8\uB85C\n\uACF5\uACA9\uC2DC
    \uD30C\uAD34\uB418\uBA70 <color=cyan>\uCCB4\uB825</color>\uC744 <color=lime>10\uD68C\uBCF5</color>\uC2DC\uCF1C\uC8FC\uB294
    \uBD95\uC5B4\uBE75\uC744 \uB5A8\uC5B4\uD2B8\uB9BD\uB2C8\uB2E4.\n\uCD5C\uB300
    \uCCB4\uB825\uC778 \uACBD\uC6B0\uC5D0\uB294 <color=lime>5</color>\uB9CC\uD07C\uC758
    <color=lime>\uC2E4\uB4DC</color>\uB85C \uC801\uC6A9\uB418\uBA70, \uC2E4\uB4DC\uB294
    \uCD5C\uB300 <color=lime>10</color>\uAE4C\uC9C0 \uC801\uC6A9\uB429\uB2C8\uB2E4.\n\uB610
    \uC774\uD30C\uB9AC \uB098\uBB34\uB97C \uBD80\uC218\uBA74 \uB0AE\uC740 \uD655\uB960\uB85C
    <color=cyan>\uD328\uC2DC\uBE0C \uC544\uC774\uD15C</color>\uC744 \uD68D\uB4DD\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD2B9\uC815 \uBAAC\uC2A4\uD130\uB4E4\uC740
    <color=cyan>\uBC29\uC5B4\uB825</color>\uC774 \uC874\uC7AC\uD569\uB2C8\uB2E4.
    \uBC29\uC5B4\uB825\uC774 \uC874\uC7AC\uD558\uB294 \uBAAC\uC2A4\uD130\uB4E4\uC740
    \uC77C\uC815\uBE44\uC728 <color=red>\uAC10\uC18C</color>\uB41C \uACF5\uACA9\uB825\uC774
    \uB4E4\uC5B4\uAC11\uB2C8\uB2E4.\n\uBAAC\uC2A4\uD130\uB4E4\uC740 \uC77C\uC815
    \uB77C\uC6B4\uB4DC\uB9C8\uB2E4 <color=cyan>\uCCB4\uB825</color>,  <color=cyan>\uBC29\uC5B4\uB825</color>, 
    <color=cyan>\uACF5\uACA9\uB825</color>\uC774  <color=red>\uC0C1\uC2B9</color>\uD569\uB2C8\uB2E4.\n\n\uC81C\uD55C\uC2DC\uAC04\uC774
    \uB05D\uB098\uBA74 \uBCF4\uC2A4 \uBAAC\uC2A4\uD130\uB4E4\uC774 <color=red>\uAD11\uD3ED\uD654</color>\uB429\uB2C8\uB2E4.\n\uAD11\uD3ED\uD654\uB41C
    \uBCF4\uC2A4\uBAAC\uC2A4\uD130\uB294 <color=lime>\uACF5\uACA9\uB825, \uC774\uB3D9\uC18D\uB3C4</color>\uAC00
    \uC99D\uAC00\uD558\uACE0 <color=lime>\uD328\uD134\uC8FC\uAE30</color>\uAC00 \uC904\uC5B4\uB4ED\uB2C8\uB2E4."
